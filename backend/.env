# ============================================================
# Smart Kisaan — environment variables
# Copy to .env and fill in values before running the app.
# NEVER commit .env to version control.
# ============================================================

# --- Django core ----------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Set to False in production
DJANGO_DEBUG=True
# Comma-separated hostnames/IPs allowed to serve the app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -------------------------------------------------------
# SQLite (dev default) — leave DB_NAME as-is and omit the rest.
# MySQL (production) — set DB_ENGINE + all five DB_* vars below.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# --- CORS -----------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- External services ----------------------------------------------
# Leave blank in development — the app uses safe mock/rule-based
# fallbacks automatically when these are empty.
#
# Weather (OpenWeatherMap):
#   blank  => MockWeatherProvider (labeled "sample data" in the UI)
#   filled => OpenWeatherMapProvider (live data, no code change needed)
WEATHER_API_KEY=

# AI Farming Assistant (Anthropic claude-sonnet-4-6):
#   blank  => RuleBasedFAQProvider (6 farming topics, English + Telugu)
#   filled => LLMProvider (open-ended answers via Anthropic API)
AI_API_KEY=

# Leave blank in development — OTP prints to the Django console instead.
